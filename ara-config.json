  "announcement": {
    "id": "v4.10.8",
    "level": "info",
    "showOnce": true,
    "msg_id": "ARA 4.10.8 — Plugin SketchUp lebih enak dipakai: lampu & Copy Path kini ikut masuk ke group, tombol tanpa pilihan langsung minta klik objeknya (tidak ada lagi kotak “Pilih dulu”), tiap alat punya kursor sendiri, dan Ctrl+Z tidak lagi mengeluarkan dari alat. Update terpasang otomatis saat aplikasi dibuka.",
    "msg_en": "ARA 4.10.8 — The SketchUp plugins are easier to use: lights and Copy Path now stay inside the group, buttons with nothing selected simply ask you to click the object (no more “select first” boxes), every tool has its own cursor, and Ctrl+Z no longer drops you out of the tool. The update installs automatically when the app opens."
  }
}
