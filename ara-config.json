{
  "configVersion": 32,
  "minAppVersion": "5.0.0",
  "webSelectors": {
    "textbox": [
      "[contenteditable=\"true\"][role=\"textbox\"]",
      ".ql-editor[contenteditable=\"true\"]",
      "rich-textarea [contenteditable=\"true\"]",
      "[contenteditable=\"true\"]",
      "textarea"
    ],
    "send": [
      "button[aria-label=\"Send message\"]",
      "button[aria-label=\"Kirim pesan\"]",
      "button[data-testid=\"send-button\"]"
    ],
    "dropzone": [
      "input[type=\"file\"]",
      "[data-serverside-action*=\"upload\" i]",
      "[class*=\"dropzone\" i]",
      "[class*=\"upload\" i][class*=\"area\" i]"
    ],
    "generating": [
      "[aria-busy=\"true\"]",
      "[role=\"progressbar\"]",
      "[aria-label*=\"Loading\" i]",
      "[aria-label*=\"Memuat\" i]",
      "mat-progress-spinner",
      "[class*=\"loading\" i][class*=\"indicator\" i]"
    ],
    "resultImg": {
      "minSize": 200,
      "exclude": [
        "avatar",
        "icon",
        "logo",
        "emoji",
        "svg",
        "gstatic",
        "favicon"
      ]
    }
  },
  "modelRegistry": {
    "geminiWeb": {
      "label": "Gemini Web (gratis)",
      "status": "ok"
    },
    "geminiApi": {
      "id": "gemini-3.1-flash-image-preview",
      "status": "ok",
      "note": ""
    },
    "gptApi": {
      "id": "gpt-image-1",
      "status": "ok",
      "note": ""
    },
    "openrouterFree": [],
    "recommend": {
      "interior": "geminiWeb",
      "sketch": "geminiWeb"
    }
  },
  "announcement": {
    "id": "v4.10.6",
    "level": "info",
    "showOnce": true,
    "msg_id": "ARA 4.10.6 — Plugin SketchUp 1.13.0 punya ARA Material: galeri material per kelompok lalu merek, cat rapi di bidang lengkung dan panel, atur ukuran, putar, dan geser langsung di bidang. Material pribadi aman saat update. Plugin diperbarui otomatis saat aplikasi dibuka.",
    "msg_en": "ARA 4.10.6 — SketchUp plugin 1.13.0 adds ARA Material: a gallery by group and brand, clean painting on curved faces and panels, with size, rotation and position adjusted directly on the face. Your personal materials stay safe across updates. The plugin updates automatically when the app opens."
  }
}
